    {
      "kind": "wordplay",
      "subject": "נשמע … נשמע",
      "rationale": "Двоен повтор на „ќе слушаме“ — заклетвата се потврдува со ист збор, рамнотежата е задржана."
    },
    {
      "kind": "addition",
      "subject": "⟨се⟩",
      "rationale": "Македонскиот среден глас бара „се“ кај „праќаме се“ — хебрејскиот има само активен облик."
    }
